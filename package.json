{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "Universal LLM Agent Runtime",
  "license": "MIT",
  "bin": {
    "harness": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "desktop": "pnpm --filter @harness/desktop dev",
    "desktop:build": "pnpm --filter @harness/desktop build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}