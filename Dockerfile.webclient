# =============================================================================
# Harness Web Client — Multi-stage Docker Build
#
# Builds the @harness/webclient package (static HTML/JS/CSS) and serves
# it via nginx, which also reverse-proxies /api/* and /ws to the backend.
#
# Usage:
#   docker build -f Dockerfile.webclient -t harness-webclient .
#
# Typically used via docker-compose alongside the harness server:
#   docker compose up
# =============================================================================

# ── Stage 1: Build static assets ────────────────────────────────────

FROM node:22-slim AS builder

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /build

# Copy workspace config and lockfile first (layer caching)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy only the webclient package.json for dependency install
COPY packages/webclient/package.json packages/webclient/

# Install dependencies (only webclient needs esbuild + typescript)
RUN pnpm install --frozen-lockfile --filter @harness/webclient

# Copy webclient source
COPY packages/webclient/ packages/webclient/

# Build static assets
RUN pnpm --filter @harness/webclient build

# ── Stage 2: Serve with nginx ───────────────────────────────────────

FROM nginx:alpine AS production

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config (reverse proxy + static file serving)
COPY packages/webclient/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static assets
COPY --from=builder /build/packages/webclient/dist /usr/share/nginx/html

EXPOSE 8080

# nginx runs as PID 1 by default via the base image entrypoint
